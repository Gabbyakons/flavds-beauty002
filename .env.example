# Required (local and online): choose your own values
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=put-a-long-random-string-here

# Online: Firebase (products in Firestore)
# Paste the whole service-account JSON file here, on one line
# FIREBASE_SERVICE_ACCOUNT=
# Optional: keep photos in Firebase Storage (needs the Blaze plan), e.g. my-project.firebasestorage.app
# FIREBASE_STORAGE_BUCKET=
# If FIREBASE_STORAGE_BUCKET is not set, photos go to a Public Vercel Blob store instead.
